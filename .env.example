NODE_ENV=development
API_PORT=3000
# On Render, PORT is set automatically and overrides API_PORT
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seo_prospector

# Auth0 (API)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.prospect-pilot.local

# Auth0 (Vite SPA)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.prospect-pilot.local
VITE_AUTH0_REDIRECT_URI=http://localhost:5173

LOG_LEVEL=debug
BUSINESS_DISCOVERY_PROVIDER=mock
# Required only when BUSINESS_DISCOVERY_PROVIDER=google
GOOGLE_PLACES_API_KEY=

# Gmail OAuth — personal inbox connect for outreach email
# Create an OAuth client in Google Cloud, enable Gmail API, set redirect URI below
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/email/gmail/callback

# Resend — email campaign blasts (verify a domain in Resend for production)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Prospect Pal <onboarding@resend.dev>

# --- Render Web Service (API) suggested settings ---
# Build Command:  npm install && npm run build:api
# Start Command:  npm start
# Pre-Deploy:     npm run db:migrate
# Health Check:   /api/health
# Env: NODE_ENV=production, WEB_ORIGIN, DATABASE_URL, AUTH0_DOMAIN, AUTH0_AUDIENCE
