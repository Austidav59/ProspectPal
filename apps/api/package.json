{
  "name": "@seo-prospector/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npx nest build",
    "dev": "npx nest start --watch",
    "lint": "eslint src test --max-warnings=0",
    "start": "node dist/src/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "node ./scripts/prisma.mjs generate",
    "prisma:migrate": "node ./scripts/prisma.mjs migrate deploy",
    "prisma:push": "node ./scripts/prisma.mjs db push",
    "postinstall": "node ./scripts/prisma.mjs generate"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/common": "^11.1.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.5",
    "@nestjs/platform-express": "^11.1.5",
    "@prisma/client": "^6.19.3",
    "cheerio": "^1.2.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.8",
    "nestjs-pino": "^4.4.0",
    "pino-http": "^10.5.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.8.0",
    "rxjs": "^7.8.2",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.5",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
